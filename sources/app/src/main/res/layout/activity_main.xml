<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <!-- MainActivity owns/reloads the backdrop so it can release it when hidden. -->

    <!-- Stack the two bars and the grid so their heights cannot overlap. -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_px"
            android:orientation="horizontal"
            android:background="@color/tab_background"
            android:gravity="center_vertical"
            android:focusable="false">

            <ImageView
                android:id="@+id/header_logo"
                android:layout_width="@dimen/header_logo_width_px"
                android:layout_height="@dimen/header_logo_height_px"
                android:layout_marginLeft="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ouya_title"
                android:contentDescription="@string/app_name"
                android:focusable="false"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"
                android:focusable="false"/>

            <FrameLayout
                android:id="@+id/header_settings_action"
                android:layout_width="@dimen/header_action_width_px"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false">

                <ImageView
                    android:id="@+id/imgHeaderSettings"
                    android:layout_width="64px"
                    android:layout_height="64px"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cogwheel"
                    android:contentDescription="@string/open_android_settings"
                    android:focusable="false"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/header_apps_action"
                android:layout_width="@dimen/header_action_width_px"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false">

                <ImageView
                    android:id="@+id/imgHeaderApps"
                    android:layout_width="64px"
                    android:layout_height="64px"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_apps"
                    android:contentDescription="@string/open_apps_settings"
                    android:focusable="false"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/header_network_action"
                android:layout_width="@dimen/header_action_width_px"
                android:layout_height="match_parent"
                android:layout_marginRight="30px"
                android:clickable="true"
                android:focusable="false">

                <ImageView
                    android:id="@+id/imgNetworkStatus"
                    android:layout_width="64px"
                    android:layout_height="64px"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_offline"
                    android:contentDescription="@string/open_internet_settings"
                    android:focusable="false"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Physical pixels intentionally: the separator stays exactly 2 px. -->
        <View
            android:id="@+id/header_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_divider_height_px"
            android:background="@color/ouya_orange"
            android:focusable="false"/>

        <FrameLayout
            android:id="@+id/tabs_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tabs_bar_height_px"
            android:background="@color/tab_background"
            android:focusable="false">

            <!-- MainActivity aligns this viewport with the unscaled tile edges. -->
            <HorizontalScrollView
                android:id="@+id/tab_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:focusable="false">
                <com.ast.ouyalaunch.SlidingTabLayout
                    android:id="@+id/tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </FrameLayout>

        <com.ast.ouyalaunch.RowAlignedRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="120dp"
            android:layout_marginEnd="120dp"
            android:paddingTop="@dimen/grid_top_padding_px"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:background="@android:color/transparent"
            android:paddingLeft="120dp"
            android:paddingRight="120dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:defaultFocusHighlightEnabled="false"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay_loading"
        android:background="#000000"
        android:clickable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reading_apps"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:layout_gravity="center"/>
    </FrameLayout>

</FrameLayout>
